# Choose AI provider: 'deepseek', 'gemini', or 'hermes'
AI_PROVIDER=deepseek

# DeepSeek Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini Settings (Backup)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Google Cloud Platform Settings (Vision, Speech-to-Text & Cloud Storage)
# Note: On Google Cloud Compute Engine VM, uses VM metadata service account token automatically if unset
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here
GOOGLE_SPEECH_API_KEY=your_google_cloud_speech_api_key_here
GCS_BUCKET_NAME=hermes-whatsapp-vault-390608

# Hermes Settings (via OpenRouter)
HERMES_API_KEY=your_openrouter_api_key_here
HERMES_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-8b

# Persona Settings
OWNER_NAME=User
BOT_NAME=Hermes AI Assistant
SYSTEM_PROMPT=You are Hermes, an intelligent personal assistant managing WhatsApp messages for your owner while they are away from their phone. Keep answers concise, polite, helpful, and natural.

# Tencent COS (50 GB package)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=hermes-whatsapp-vault-1498387033
COS_REGION=ap-singapore

# Public https address of this server, used in file/vault links sent on WhatsApp
PUBLIC_BASE_URL=https://your-domain.example

COS_URL_TTL_DAYS=30

# Tencent Cloud OCR uses the COS key pair unless these are set; TENCENT_OCR=off disables it
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_OCR=off

DOC_MAX_PDF_PAGES=8

# Mizoram Bonanza member list (report assistant + broadcast)
MIZORAM_API_URL=https://your-ledger-app.example/api/mizoram_bronze
REPORT_MAX_PER_DAY=5

SENDER_URL=http://127.0.0.1:3100
